["inv++/harvard_fleet.lua"]=[=[
-- Shared queue policy for Harvard. Native source guards own the pause barrier.
return function(context,B,C)
 C=C or {}
 local F=B.F local P=C.Player or game.Players.LocalPlayer local Http=game:GetService("HttpService")
 local clock=C.Clock or os.clock local now=C.Now or os.time local root=C.Root or "Inv++/fleet"
 local function read(path) local ok,v=pcall(function() return Http:JSONDecode(readfile(path)) end) return ok and v or nil end
