["inv++/harvard_transfer_upgrader.lua"]=[=[
-- Upgrade the exact transfer UID in the shared lobby before offering it.
return function(B,C)
 C=C or {}
 local P=C.Player or game.Players.LocalPlayer
 local clock=C.Clock or os.clock local now=C.Now or os.time
 local path="Inv++/fleet/job.json" local H=game:GetService("HttpService")
 local function read() if C.Read then return C.Read() end local ok,j=pcall(function() return H:JSONDecode(readfile(path)) end) return ok and j or nil end
 local function write(j) if C.Write then return C.Write(j) end writefile(path,H:JSONEncode(j)) end
 local T={status="Waiting for a transfer",ready=false}
 B.TransferUpgrader=T
 local function find(uid) for key,r in pairs(B.A.index) do if r.item.UniqueItemID==uid then return r,tonumber(key:match(":(%d+)$")) end end end
 function T.step()
  local j=read()
  if not j or j.stage~="preupgrade" or j.source~=P.UserId then return end
  if T.job~=j.id then T.job=j.id T.ready=false T.pending=nil T.error=nil end
  if T.ready or T.error or not B.isLobby() or B.safetyPaused() then return end
  B.refresh()
  local current=read()
  if not current or current.id~=j.id or current.stage~="preupgrade" or not B.isLobby() then return end
  local r,slot=find(j.item.uid)
  if not r or not slot or r.kind~=j.item.kind or r.item.equipped==true then T.error="Transfer item changed before upgrade" return end
  local i=r.item
  if T.pending then
   if (tonumber(i.currentUpgrade) or 0)>T.pending.before then T.pending=nil T.ready=true T.status="Transfer item upgraded" B.F.publish(true)
   elseif clock()-T.pending.sent>=8 then T.error="Transfer upgrade was not confirmed" T.pending=nil B.F.publish(true) end
   return
  end
  if r.kind=="ability" then T.ready=true T.status="Spell needs no item upgrades" return end
  local remaining=(tonumber(i.maxUpgrades) or 0)-(tonumber(i.currentUpgrade) or 0)
  local gold=B.A.Extras.gold()
  local affordable=gold and B.A.Extras.affordableUpgrades(i,gold)
  if remaining<=0 or affordable and affordable<=0 then T.ready=true T.status=remaining<=0 and "Transfer item already maxed" or "No affordable upgrades; recipient can finish" return end
  if not affordable then T.error="Cannot verify available upgrade gold" return end
  local stat=({spellPower="spell",physicalPower="physical",physicalDamage="physical",health="health"})[j.item.field]
  if not stat then T.error="Unknown transfer upgrade stat" return end
  T.pending={before=tonumber(i.currentUpgrade) or 0,sent=clock()}
  T.status="Upgrading "..i.name.." before trade"
  local ok,err=pcall(function()
   if C.Send then C.Send(r.kind,slot,stat,remaining,"spendAll")
   else game.ReplicatedStorage.remotes.upgradeItem:FireServer(r.kind,slot,stat,remaining,"spendAll") end
  end)
  if not ok then T.pending=nil T.error=tostring(err) end
  B.F.publish(true)
 end
 local settings=B.queueSettings
 B.queueSettings=function() local q=settings() q.transferUpgrade={job=T.job,ready=T.ready,error=T.error,status=T.status} return q end
 local coordinate=B.F.coordinate
 B.F.coordinate=function(j,members)
  if j and j.stage~="failed" and j.stage~="complete" and (j.cancel or not B.F.config.automatic) then return coordinate(j,members) end
  if j and not j.queueOnly and j.stage=="gather" and j.anchorJob then
   local all=#members==#j.members
   for _,m in ipairs(members) do if not m.lobby or m.job~=j.anchorJob or m.activeJob~=j.id then all=false end end
   if all then
    local ready,message=B.allReady(members,true) if not ready then B.F.status=message return end
    local source for _,m in ipairs(members) do if m.id==j.source then source=m end end
    local item for _,i in ipairs(source and source.items or {}) do if i.uid==j.item.uid then item=i end end
    local recipient=item and B.F.recipient(source,item,members)
    if not recipient or recipient.id~=j.target then return B.F.fail(j,"Transfer no longer improves recipient") end
    j.stage="preupgrade" j.updated=now() write(j) return
   end
  elseif j and j.stage=="preupgrade" then
   if now()-j.created>360 then return B.F.fail(j,"Transfer upgrade stage timed out") end
   local ready,message=B.allReady(members,true) if not ready then B.F.status=message return end
   for _,m in ipairs(members) do if m.id==j.source then
    local state=m.harvard and m.harvard.transferUpgrade
    if state and state.job==j.id then
     if state.error then return B.F.fail(j,state.error) end
     if state.ready then j.stage="trade" j.updated=now() write(j) return end
    end
   end end
   B.F.status="Upgrading transfer item before trade" return
  end
  return coordinate(j,members)
 end
 if not C.NoWorker then task.spawn(function() while B.alive and B.App.Alive do local ok,err=pcall(T.step) if not ok then T.error=tostring(err) end task.wait(.5) end end) end
 return T
end
