  if B.F.config.lobbyUpgradeEquipped==false then return {verified=true,needed=false} end
  local A=B.A
  if not A.index or not A.AutoEquip or not A.Extras then return {verified=false,needed=false} end
  local gold=A.Extras.gold() if not gold then return {verified=false,needed=false} end
  local best={} local values={}
  for _,r in pairs(A.index) do if ({weapon=true,helmet=true,chest=true})[r.kind] then
