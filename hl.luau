["inv++/harvard_settings_layout.lua"]=[=[
-- Place extension settings beside Harvard's existing settings for the same task.
return function(context,B)
 local function section(names)
  if type(names)=="string" then names={names} end
  for holder,info in pairs(context.sectionReg or {}) do if holder.Parent and info.head and info.head.Parent then
   for _,v in ipairs(info.head:GetDescendants()) do if v:IsA("TextLabel") and table.find(names,v.Text) then return {holder=holder,info=info,title=v} end end
  end end
 end
 local function replaceText(root,old,new)
  if not root then return end
  if root:IsA("TextButton") and root.Text==old then root.Text=new end
  for _,v in ipairs(root:GetDescendants()) do if (v:IsA("TextLabel") or v:IsA("TextButton")) and v.Text==old then v.Text=new end end
 end
 local function row(content,text)
  if not content then return end
  for _,v in ipairs(content:GetChildren()) do if v:IsA("GuiObject") then
   if (v:IsA("TextLabel") or v:IsA("TextButton")) and v.Text==text then return v end
   for _,label in ipairs(v:GetDescendants()) do if (label:IsA("TextLabel") or label:IsA("TextButton")) and label.Text==text then return v end end
  end end
 end
 local function route(s,page,title,order)
  local p=context.Shell and context.Shell.pages[page]
  if not s or not p or not p.body then return false end
  s.holder.Parent=p.body s.holder.LayoutOrder=order s.title.Text=title return true
 end
 local function controlHolder(control)
  return control and (control.row or control.holder or control.native and (control.native.row or control.native.holder))
 end
 local function merge(s,target,orders)
  if not s or not target then return end
  local n=0
  for _,v in ipairs(s.info.content:GetChildren()) do if v:IsA("GuiObject") and v.Name~="Description" then
   n+=1 v.Parent=target.info.content v.LayoutOrder=orders[n] or 900+n
  end end
  context.sectionReg[s.holder]=nil s.holder:Destroy()
 end
 local function layout()
  local transfers=section({"Inv++ Account Transfers","Gear transfers"})
  if route(transfers,"AltFarm","Gear transfers",4) then
   local description=transfers.info.content:FindFirstChild("Description")
   if description then description.Text="Trade useful gear between your accounts, then queue the party together." end
  end
  local camera=section({"Additional camera views","Camera"})
  if route(camera,"Visuals","Camera",2) then
   replaceText(camera.holder,"Additional view","View")
   replaceText(camera.holder,"View distance","Distance") replaceText(camera.holder,"View height","Height")
   replaceText(camera.holder,"Reset extra camera","Reset camera")
   local d=camera.info.content:FindFirstChild("Description") if d then d.Text="Choose the camera view for this account." end
  end
  local party=section({"Party watermark","Party HUD"})
  if route(party,"Visuals","Party HUD",3) then
   replaceText(party.holder,"Show party watermark","Show the party HUD")
   replaceText(party.holder,"Reset watermark position","Reset position")
   local d=party.info.content:FindFirstChild("Description") if d then d.Text="Your accounts, equipped items and spells in a movable HUD." end
  end
  local guests=section({"Guest access","Guests"})
  if route(guests,"AltFarm","Guests",5) then
   replaceText(guests.holder,"Who can join","Allow") replaceText(guests.holder,"Guest usernames","Usernames")
   replaceText(guests.holder,"Guest join window (seconds)","Wait for guests")
   local d=guests.info.content:FindFirstChild("Description") if d then d.Text="Who can join the party before the dungeon starts." end
  end
  local script=section("Script")
  local startup=B.library and B.library.Toggles["Inv++/Harvard/startMinimized"]
  local startupRow=controlHolder(startup)
  if script and startupRow then
   startupRow.Parent=script.info.content startupRow.LayoutOrder=2
   replaceText(startupRow,"Start Harvard minimized","Start minimized")
   local close=row(script.info.content,"Close the script") if close then close.LayoutOrder=30 end
   for _,v in ipairs(script.info.content:GetChildren()) do if v:IsA("GuiObject") then
    for _,t in ipairs(v:GetDescendants()) do if t:IsA("TextButton") and t.Text:find("Menu key:",1,true)==1 then v.LayoutOrder=10 end end
   end end
   startupRow.LayoutOrder=20
  end
  local gear=section("Gear, Spells & Stats")
  if gear then
   local content=gear.info.content
   if not B.NativeStatRow then B.NativeStatRow=row(content,"Spend skill points") end
   if B.NativeStatRow then B.NativeStatRow.Visible=false end
   for i,name in ipairs({"Auto mode","Priority","Equip best spells","Spend skill points","Only swap outside a run"}) do
    local v=row(content,name) if v then v.LayoutOrder=i*10 end
   end
   local apply=row(content,"Apply best now") if apply then apply.LayoutOrder=70 end
   local stat=section("Auto Stat")
   if stat then
    replaceText(stat.holder,"Spend points on level up","Spend skill points")
    replaceText(stat.holder,"Stat class","Spend points on")
    merge(stat,gear,{40,44,48})
   end
   local U=B.LobbyUpgrader local upgrade=U and controlHolder(U.control)
   if upgrade then upgrade.Parent=content upgrade.LayoutOrder=60 replaceText(upgrade,"Max equipped gear in lobby","Upgrade equipped gear") end
   if U and U.label then U.label.Parent=content U.label.LayoutOrder=65 end
   local statStatus=B.Features and B.Features.statLabel and B.Features.statLabel.Label
   for _,v in ipairs(content:GetChildren()) do if v:IsA("TextLabel") and v.Name~="Description" and v~=(U and U.label) and v~=statStatus then v.LayoutOrder=80 end end
  end
  local cards=section("Item cards") local tools=section("Inventory tools")
  if cards and tools and (not startupRow or startupRow.Parent~=tools.info.content) then
   replaceText(tools.holder,"Open Inventory Tools","Inventory tools")
   replaceText(tools.holder,"Refresh connected inventories","Refresh inventory")
   merge(tools,cards,{80,81,82})
  end
  if cards then for _,v in ipairs(cards.info.content:GetChildren()) do if v:IsA("TextLabel") and v.Text:find("Native inventory visuals",1,true)==1 then v.Text="Search filters, item history and display options." end end end
  for i,title in ipairs({"Screen","Camera","Minimap","Item cards","Party HUD","Streamer mode","Notifications","Color theme"}) do local s=section(title) if s then s.holder.LayoutOrder=i*10 end end
  for i,title in ipairs({"Parties","Dungeon","Gear transfers","Guests","Boss raids","Options"}) do local s=section(title) if s and context.Shell.pages.AltFarm and s.holder.Parent==context.Shell.pages.AltFarm.body then s.holder.LayoutOrder=i*10 end end
  return true
 end
 B.SettingsLayout=layout return layout
end
