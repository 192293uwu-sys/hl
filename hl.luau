["inv++/auto_stat_core.lua"]=[=[
return function(C)
 local S={enabled=true,class=C.Class,pending=nil,failures=0,retryAt=0,spent=0,status="Waiting for points"}
 local fields={Mage="spellPower",Warrior="physicalPower",Guardian="stamina"}
 function S.step()
  local now=C.Clock() local points=math.max(0,math.floor(tonumber(C.Points()) or 0))
  if S.pending then
   local p=S.pending
   if points<=p.points-p.amount and C.Stat(p.field)>=p.stat+p.amount then
    S.spent+=p.amount S.pending=nil S.failures=0 S.status="Allocated "..p.amount.." to "..p.field
   elseif now-p.time>=4 then
    S.pending=nil S.failures+=1 S.retryAt=now+6
    S.status=S.failures>=3 and "Allocation unconfirmed — toggle off/on to retry" or "Waiting to retry allocation"
   else return end
  end
  if not S.enabled then S.status="Off" return end
  if S.failures>=3 or now<S.retryAt then return end
  if points==0 then S.status="Watching for new points" return end
  local field=fields[S.class]
  if not field then S.status="Choose a class" return end
  if C.Ready and not C.Ready() then S.status="Waiting for player data" return end
  S.pending={field=field,points=points,amount=points,stat=C.Stat(field),time=now}
  S.status="Allocating "..points.." point(s)"
  local ok,err=pcall(C.Send,field,points)
  if not ok then S.pending=nil S.failures+=1 S.retryAt=now+6 S.status="Allocation request failed" S.lastError=tostring(err) end
 end
 function S.setEnabled(v) S.enabled=v==true S.failures=0 S.retryAt=0 end
 return S
end
]=],
