["inv++/harvard_config_codec.lua"]=[=[
-- Portable settings data. Decoding never evaluates code.
return function(H)
 local K={} local alphabet="ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
 local lookup={} for i=1,#alphabet do lookup[alphabet:sub(i,i)]=i-1 end
 local function sum(s) local a,b=1,0 for i=1,#s do a=(a+s:byte(i))%65521 b=(b+a)%65521 end return string.format("%08x",b*65536+a) end
 function K.encode(data)
  local raw=H:JSONEncode(data) assert(#raw<=131072,"Config is too large") local out={}
  local acc,bits=0,0
  for i=1,#raw do acc=acc*256+raw:byte(i) bits+=8 while bits>=6 do bits-=6 local n=math.floor(acc/2^bits) table.insert(out,alphabet:sub(n+1,n+1)) acc=acc%2^bits end end
  if bits>0 then local n=acc*2^(6-bits) table.insert(out,alphabet:sub(n+1,n+1)) end
  return "HLC1:"..table.concat(out).."."..sum(raw)
 end
 function K.decode(code)
  assert(type(code)=="string" and #code<=196608,"Config code is too large") code=code:gsub("%s","")
  local payload,checksum=code:match("^HLC1:([%w_-]+)%.(%x%x%x%x%x%x%x%x)$")
  assert(payload and #payload%4~=1,"Use a complete HLC1 config code")
  local out={} local acc,bits=0,0
  for i=1,#payload do local n=lookup[payload:sub(i,i)] assert(n,"Invalid config character") acc=acc*64+n bits+=6
   if bits>=8 then bits-=8 local c=math.floor(acc/2^bits) table.insert(out,string.char(c)) acc=acc%2^bits end
  end
  assert(acc==0,"Invalid config padding") local raw=table.concat(out)
  assert(#raw<=131072 and sum(raw)==checksum:lower(),"Config code is incomplete or changed")
  local ok,data=pcall(H.JSONDecode,H,raw) assert(ok and type(data)=="table","Config code contains invalid data")
  assert(data.format=="HarvardLabs" and data.version==1,"Unsupported config version") return data
 end
 return K
end
