["inv++/auto_stat.lua"]=[=[
local E=getgenv()
if E.InvPlusAutoStat and E.InvPlusAutoStat.alive then return E.InvPlusAutoStat end
local P=game.Players.LocalPlayer or game.Players.PlayerAdded:Wait()
local classes={mgtargeter01="Warrior",ariesxmraw6="Mage",latiyahbadie48="Mage"}
if not classes[P.Name] then return end
local H=game:GetService("HttpService")
local configPath="Inv++/auto_stat_"..P.UserId..".json"
local cfg={enabled=true,class=classes[P.Name]}
pcall(function() local d=H:JSONDecode(readfile(configPath)) if type(d.enabled)=="boolean" then cfg.enabled=d.enabled end if table.find({"Mage","Warrior","Guardian"},d.class) then cfg.class=d.class end end)
local A={alive=true,connections={},config=cfg}
E.InvPlusAutoStat=A
local points=P:WaitForChild("skillPoints",90)
assert(points,"Auto Stat: player points not loaded")
local remotes=game.ReplicatedStorage:WaitForChild("remotes",90)
local remote=remotes and remotes:WaitForChild("spendSkillPoint",90)
assert(remote and remote:IsA("RemoteEvent"),"Auto Stat: allocation remote not loaded")
local function stat(field) local v=P:FindFirstChild(field) return v and tonumber(v.Value) or 0 end
local S=assert(loadstring(readfile("Inv++/auto_stat_core.lua")))()({
 Class=cfg.class,Clock=os.clock,Points=function() return points.Value end,Stat=stat,
 Ready=function() local d=P:FindFirstChild("dataLoaded") local t=P:FindFirstChild("teleporting") return d and d.Value==true and not(t and t.Value) and P:FindFirstChild("physicalPower") and P:FindFirstChild("spellPower") and P:FindFirstChild("stamina") end,
 Send=function(field,amount) remote:FireServer(field,amount) end,
})
A.state=S S.setEnabled(cfg.enabled)
local function save() writefile(configPath,H:JSONEncode(cfg)) end
save()
local function step() if A.alive then local ok,err=pcall(S.step) if not ok then S.status="Auto Stat error" A.lastError=tostring(err) end end end
table.insert(A.connections,points:GetPropertyChangedSignal("Value"):Connect(function() task.defer(step) end))
for _,field in ipairs({"physicalPower","spellPower","stamina"}) do
 local v=P:FindFirstChild(field)
 if v then table.insert(A.connections,v:GetPropertyChangedSignal("Value"):Connect(function() task.defer(step) end)) end
end
local function mount()
 local L=E.Library
 if not L or L.Unloaded or not L.Tabs or A.library==L then return end
 local tab=L.Tabs.Automation or L.Tabs.Main
 if not tab then return end
 local group=tab:AddRightGroupbox("Auto Stat")
 A.group=group A.library=L A.rendering=true
 A.toggle=group:AddToggle("Inv++/AutoStat/enabled",{Text="Auto Stat",Default=cfg.enabled,Callback=function(v) if A.alive and not A.rendering then cfg.enabled=v S.setEnabled(v) save() task.defer(step) end end})
 A.dropdown=group:AddDropdown("Inv++/AutoStat/class",{Text="Stat class",Values={"Mage","Warrior","Guardian"},Default=cfg.class,Callback=function(v) if A.alive and not A.rendering then cfg.class=v S.class=v save() task.defer(step) end end})
 A.label=group:AddLabel({Text=S.status,DoesWrap=true})
 group:AddLabel({Text="Mage: spell power · Warrior: physical power · Guardian: stamina. Spends unallocated points only.",DoesWrap=true})
 A.rendering=false
end
local queue=queue_on_teleport or (syn and syn.queue_on_teleport)
if type(queue)=="function" and not getgenv().InvPlusHarvardContext then
 table.insert(A.connections,P.OnTeleport:Connect(function(state)
  if state==Enum.TeleportState.Started and A.alive then pcall(queue,[[repeat task.wait() until game:IsLoaded() loadstring(readfile("Inv++/auto_stat.lua"))()]]) end
 end))
end
function A.destroy()
 A.alive=false for _,v in ipairs(A.connections) do v:Disconnect() end
 if A.group then A.group:Destroy() end
 if E.InvPlusAutoStat==A then E.InvPlusAutoStat=nil end
end
task.spawn(function() while A.alive do step() pcall(mount) if A.label then pcall(function() A.label:SetText(S.status.." · "..S.spent.." allocated this session") end) end task.wait(1) end end)
print("[Auto Stat] Enabled for "..P.Name.." → "..cfg.class)
return A
