["inv++/harvard_camera_views.lua"]=[=[
-- Additional camera views using public Obsidian controls and Roblox's camera.
return function(B)
 if B.CameraViews and B.CameraViews.alive then return B.CameraViews end
 local P=game.Players.LocalPlayer local L=B.library local Run=game:GetService("RunService") local H=game:GetService("HttpService")
 local group=assert(L.Tabs.Player.Groupboxes.Camera,"Camera group unavailable")
 local C={alive=true,controls={},mode="Native",angle=0} B.CameraViews=C
 local path="Inv++/camera_views_"..P.UserId..".json"
 local modes={"Native","Isometric","Tactical","Right shoulder","Left shoulder","Side","Front","Orbit","Party overview"}
 local prefs={mode="Native",distance=44,height=24,fov=70,orbitSpeed=12,smooth=true,collision=true,nativeView="None"}
 pcall(function() local saved=H:JSONDecode(readfile(path)) for k,v in pairs(prefs) do if type(saved[k])==type(v) then prefs[k]=saved[k] end end end)
 if not table.find(modes,prefs.mode) then prefs.mode="Native" end
 for k,range in pairs({distance={8,150},height={2,140},fov={40,110},orbitSpeed={2,45}}) do prefs[k]=math.clamp(prefs[k],range[1],range[2]) end
 C.prefs=prefs C.modes=modes
 local native=L.Options["Player/Camera/view"]
 local function save() writefile(path,H:JSONEncode(prefs)) end
 local function release()
  local old=C.previous local cam=C.camera
  if old and cam and cam==workspace.CurrentCamera then
   cam.CameraType=old.type cam.CameraSubject=old.subject and old.subject.Parent and old.subject or P.Character and P.Character:FindFirstChildOfClass("Humanoid") cam.FieldOfView=old.fov
  end
  C.previous=nil C.camera=nil C.focus=nil C.eye=nil C.root=nil
 end
 function C.setMode(mode,persist)
  if not table.find(modes,mode) then return end
  local was=C.mode C.mode=mode prefs.mode=mode
  if mode=="Native" then
   release()
   if was~="Native" and native and table.find(native.Values,prefs.nativeView) then native:SetValue(prefs.nativeView) end
  elseif was=="Native" then
   -- Disable only the public native camera mode to avoid two camera writers.
   prefs.nativeView=native.Value native:SetValue("None")
  end
  if persist~=false then save() end
 end
 local function subjectPosition()
  local char=P.Character local root=char and char:FindFirstChild("HumanoidRootPart")
  local hum=char and char:FindFirstChildOfClass("Humanoid")
  if not root or not hum or hum.Health<=0 then return end
  local center=root.Position+Vector3.new(0,2,0) local radius=0
  if C.mode=="Party overview" then
   local points={root.Position}
   for _,m in ipairs(B.F.config.roster or {}) do if m.id~=P.UserId then
    local player=game.Players:GetPlayerByUserId(m.id) local r=player and player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if r and (r.Position-root.Position).Magnitude<600 then table.insert(points,r.Position) end
   end end
   center=Vector3.zero for _,v in ipairs(points) do center+=v end center=center/#points+Vector3.new(0,2,0)
   for _,v in ipairs(points) do radius=math.max(radius,(v-center).Magnitude) end
  end
  return center,root,radius
 end
 function C.step(dt)
  if not C.alive or C.mode=="Native" or L.Unloaded then return end
  -- A manual native camera selection takes precedence over our extra view.
  if native.Value~="None" then prefs.nativeView=native.Value L.Options["Inv++/Camera/mode"]:SetValue("Native") return end
  local cam=workspace.CurrentCamera if not cam then return end
  local center,root,radius=subjectPosition() if not center then release() return end
  if C.camera~=cam then
   release() C.camera=cam C.previous={type=cam.CameraType,subject=cam.CameraSubject,fov=cam.FieldOfView}
  end
  if C.root~=root then C.root=root C.focus=nil C.eye=cam.CFrame.Position end
  local vertical=math.rad(prefs.fov)*.5 local aspect=cam.ViewportSize.X/math.max(1,cam.ViewportSize.Y)
  local halfAngle=math.min(vertical,math.atan(math.tan(vertical)*aspect))
  local distance=math.max(prefs.distance,radius>0 and radius/math.sin(halfAngle)+8 or 0) local height=prefs.height local offset
  local forward=Vector3.new(root.CFrame.LookVector.X,0,root.CFrame.LookVector.Z)
  if forward.Magnitude<.01 then forward=Vector3.new(0,0,-1) else forward=forward.Unit end
  local right=forward:Cross(Vector3.yAxis)
  if C.mode=="Right shoulder" or C.mode=="Left shoulder" then
   offset=-forward*distance+right*(C.mode=="Right shoulder" and 1 or -1)*distance*.32+Vector3.yAxis*height
  elseif C.mode=="Front" then offset=forward*distance+Vector3.yAxis*height
  elseif C.mode=="Side" then offset=Vector3.new(distance,height,0)
  elseif C.mode=="Tactical" then offset=Vector3.new(0,math.max(height,distance*1.6),distance*.35)
  elseif C.mode=="Orbit" then
   C.angle+=dt*math.rad(prefs.orbitSpeed) offset=Vector3.new(math.sin(C.angle)*distance,height,math.cos(C.angle)*distance)
  else offset=Vector3.new(distance*.707,math.max(height,radius*.9),distance*.707) end
  local alpha=prefs.smooth and (1-math.exp(-math.min(dt,.1)*9)) or 1
  C.focus=C.focus and C.focus:Lerp(center,alpha) or center center=C.focus
  local desiredEye=center+offset
  C.eye=C.eye and C.eye:Lerp(desiredEye,alpha) or desiredEye
  local eye=C.eye
  if prefs.collision then
   local params=RaycastParams.new() params.FilterType=Enum.RaycastFilterType.Exclude params.RespectCanCollide=true
   local excluded={} for _,player in ipairs(game.Players:GetPlayers()) do if player.Character then table.insert(excluded,player.Character) end end
   params.FilterDescendantsInstances=excluded
   local hit=workspace:Raycast(center,eye-center,params)
   if hit then eye=center+(eye-center).Unit*math.max(.5,hit.Distance-1) end
  end
  local target=CFrame.lookAt(eye,center)
  cam.CameraType=Enum.CameraType.Scriptable
  cam.CFrame=target
  cam.Focus=CFrame.new(center) cam.FieldOfView=prefs.fov C.lastPosition=eye C.lastFocus=center
 end
 local function add(control) table.insert(C.controls,control) return control end
 add(group:AddDropdown("Inv++/Camera/mode",{Text="Additional view",Values=modes,Default=prefs.mode,Tooltip="Native uses Harvard's existing camera settings. Extra views are cosmetic and do not change movement or dodging.",Callback=function(v) if C.mounted then C.setMode(v) end end}))
