 function R.bindCards()
  local inv=P.PlayerGui:FindFirstChild("inventory") local main=inv and inv:FindFirstChild("mainBackground") local inner=main and main:FindFirstChild("innerBackground")
  if not inner then return end
  local right=inner:FindFirstChild("rightSideFrame") local bag=right and right:FindFirstChild("ScrollingFrame") local left=inner:FindFirstChild("leftSideFrame")
  local active={}
  for _,container in ipairs({bag or false,left or false}) do if container then for _,card in ipairs(container:GetChildren()) do
   local t=card:IsA("GuiObject") and card:FindFirstChild("itemType") local id=t and t:FindFirstChild("uniqueItemNum")
   local record=id and A.index[t.Value..":"..tostring(id.Value)]
   if record and uid(record) then
    active[card]=true local state=R.markers[card]
    if not state then
     state={connections={}} R.markers[card]=state
