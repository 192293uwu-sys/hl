["inv++/harvard_statistics_core.lua"]=[=[
-- Pure accounting: no remotes, game access, files or UI.
return function()
 local K={}
 function K.finite(n) return type(n)=="number" and n==n and math.abs(n)<math.huge end
 function K.aggregate()
  return {online=0,farming=0,dungeon=0,alive=0,runs=0,wins=0,losses=0,unfinished=0,deaths=0,
   mobs=0,bosses=0,dealt=0,healed=0,taken=0,xp=0,levels=0,xpGaps=0,
   goldIn=0,goldOut=0,gemsIn=0,gemsOut=0,candyIn=0,candyOut=0,
   timedWins=0,clearSeconds=0,deathless=0,completedDeaths=0,streak=0,bestStreak=0,
   drops=0,importedDrops=0,unknownRarity=0,high90=0,high95=0,perfect=0,potCount=0,potSum=0,
   rarities={},kinds={},names={},maps={},pingN=0,pingSum=0,fpsN=0,fpsSum=0}
 end
 function K.new(now)
  return {version=1,since=now,all=K.aggregate(),session={since=now,last=now,data=K.aggregate()},
   seenLoot={},finished={},recent={},baselines={}}
 end
 function K.normalize(s,now)
  assert(type(s)=="table" and s.version==1 and type(s.all)=="table" and type(s.session)=="table","Unsupported statistics file")
  for _,t in ipairs({s.all,s.session.data}) do
   assert(type(t)=="table","Missing statistics totals")
   for k,v in pairs(K.aggregate()) do if t[k]==nil then t[k]=v elseif type(v)~=type(t[k]) then error("Invalid statistics field: "..k) elseif type(v)=="number" then assert(K.finite(t[k]) and t[k]>=0,"Invalid statistics total: "..k) end end
  end
  for _,k in ipairs({"seenLoot","finished","recent","baselines"}) do assert(type(s[k])=="table","Missing statistics ledger") end
  assert(K.finite(s.since) and K.finite(s.session.since) and K.finite(s.session.last),"Invalid statistics dates")
  if now-s.session.last>21600 then s.session={since=now,last=now,data=K.aggregate()} s.baselines={} s.active=nil end
  return s
 end
 function K.add(s,k,n)
  if not K.finite(n) or n<=0 then return end
  for _,a in ipairs({s.all,s.session.data}) do a[k]=(a[k] or 0)+n end
 end
 function K.sample(s,family,n)
  if not K.finite(n) or n<0 then return end
  for _,a in ipairs({s.all,s.session.data}) do
   a[family.."N"]+=1 a[family.."Sum"]+=n
   a[family.."Min"]=math.min(a[family.."Min"] or n,n) a[family.."Max"]=math.max(a[family.."Max"] or n,n)
  end
 end
 function K.balance(s,key,n)
  if not K.finite(n) then return end
  local old=s.baselines[key] s.baselines[key]=n
  if old==nil then return end
  local d=n-old if d>0 then K.add(s,key.."In",d) elseif d<0 then K.add(s,key.."Out",-d) end
 end
 function K.progress(s,level,xp,needed)
  if not K.finite(level) or not K.finite(xp) or not K.finite(needed) or needed<=0 then return end
  local old=s.baselines.progress s.baselines.progress={level=level,xp=xp,needed=needed}
  if not old then return end
  local levels=level-old.level
  if levels>0 then K.add(s,"levels",levels) end
  if levels==0 and xp>=old.xp then K.add(s,"xp",xp-old.xp)
  elseif levels==1 then K.add(s,"xp",math.max(0,old.needed-old.xp)+xp)
  elseif levels>1 then K.add(s,"xpGaps",1) end
 end
 function K.counter(s,job,key,n)
  if not K.finite(n) or n<0 then return end
  if s.baselines.combatJob~=job then s.baselines.combatJob=job s.baselines.combat={} end
  local old=s.baselines.combat[key] s.baselines.combat[key]=n
  if old==nil then return end
  -- The server resets these counters for a new round. Missing values never become zero.
  K.add(s,key,n>=old and n-old or n)
 end
 function K.begin(s,key,map,difficulty,now,partial)
  if s.finished[key] or s.active and s.active.key==key then return false end
  if s.active then K.finish(s,s.active.key,"unfinished",nil,now) end
  s.active={key=key,map=map or "Unknown",difficulty=difficulty or "Unknown",started=now,partial=partial==true,
   deaths=0,dealt=0,healed=0,taken=0}
  return true
 end
 function K.finish(s,key,result,seconds,now)
  if s.finished[key] then return false end
  local r=s.active if not r or r.key~=key then return false end
  assert(result=="wins" or result=="losses" or result=="unfinished","Invalid run result")
  s.finished[key]=now r.result=result r.ended=now
  r.seconds=K.finite(seconds) and math.max(seconds,0) or nil
  for _,a in ipairs({s.all,s.session.data}) do
   a.runs+=1 a[result]+=1
   if result=="wins" then a.streak+=1 a.bestStreak=math.max(a.bestStreak,a.streak) else a.streak=0 end
   local mapkey=r.map.." | "..r.difficulty
   local m=a.maps[mapkey] or {runs=0,wins=0,losses=0,unfinished=0,timed=0,seconds=0,deaths=0}
   local deaths=a==s.all and r.deaths or r.sessionDeaths or r.deaths
   a.maps[mapkey]=m m.runs+=1 m[result]+=1 m.deaths+=deaths
   if result~="unfinished" then a.completedDeaths+=deaths end
   if result=="wins" and not r.partial and not (a==s.session.data and r.sessionPartial) and r.seconds and r.seconds>0 then
    a.timedWins+=1 a.clearSeconds+=r.seconds a.fastest=math.min(a.fastest or r.seconds,r.seconds) a.slowest=math.max(a.slowest or r.seconds,r.seconds)
    m.timed+=1 m.seconds+=r.seconds m.fastest=math.min(m.fastest or r.seconds,r.seconds)
    if r.deaths==0 then a.deathless+=1 end
   end
  end
  table.insert(s.recent,1,r) while #s.recent>100 do table.remove(s.recent) end s.active=nil return true
 end
 function K.loot(s,uid,entry,record,pot)
  if s.seenLoot[uid] or type(entry)~="table" or entry.acquisition~="drop" or entry.confirmation~="reward-inventory-match" or not K.finite(entry.droppedAt) then return false end
  local item=record and record.item or {} local imported=entry.droppedAt<s.since
  s.seenLoot[uid]=true
  local targets={s.all} if entry.droppedAt>=s.session.since then table.insert(targets,s.session.data) end
  for _,a in ipairs(targets) do
   a.drops+=1 if imported then a.importedDrops+=1 end
   local rarity=tostring(item.rarity or "unknown"):lower() a.rarities[rarity]=(a.rarities[rarity] or 0)+1
   local kind=record and record.kind or entry.kind or "unknown" a.kinds[kind]=(a.kinds[kind] or 0)+1
   a.names[entry.name or item.name or "Unknown"]=true
   if K.finite(pot) and pot>=0 and pot<=100 then
    a.potCount+=1 a.potSum+=pot if pot>=90 then a.high90+=1 end if pot>=95 then a.high95+=1 end if pot>=99.95 then a.perfect+=1 end
    if not a.bestPot or pot>a.bestPot.value then a.bestPot={value=pot,name=item.name or entry.name or "Item",at=entry.droppedAt} end
   end
  end
  return true
 end
 return K
end
