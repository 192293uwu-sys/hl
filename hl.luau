["inv++/harvard_guest_access.lua"]=[=[
-- Guest admission is separate from the managed-client and item-transfer rosters.
return function(B,C)
 C=C or {}
 if B.Guests and B.Guests.alive then return B.Guests end
 local F=B.F local P=C.Player or game.Players.LocalPlayer local Players=C.Players or game.Players
 local H=game:GetService("HttpService") local now=C.Now or os.time
 local path="Inv++/fleet/guest_access.json" local jobPath="Inv++/fleet/job.json"
 local G={alive=true,version="1.0.0",status="Guest access ready",actions={},windows={}}
 B.Guests=G
 local modes={"Clients only","Named guests","Anyone"}
 local valid={} for _,mode in ipairs(modes) do valid[mode]=true end
 local function read(p)
  if C.Read then return C.Read(p) end
  if not isfile(p) then return nil end
  local ok,v=pcall(function() return H:JSONDecode(readfile(p)) end)
  if ok and type(v)=="table" then return v end
 end
 local function write(p,v)
  if C.Write then return C.Write(p,v) end
  writefile(p,H:JSONEncode(v))
 end
 local function normalize(value)
  local names={} local seen={}
  for name in tostring(value or ""):gmatch("[^,%s;]+") do
   if #name<3 or #name>20 or not name:match("^[%w_]+$") then return nil,"Use Roblox usernames, separated by commas" end
   local lower=name:lower()
   if not seen[lower] then seen[lower]=true table.insert(names,name) end
   if #names>100 then return nil,"Use at most 100 guest usernames" end
  end
  return table.concat(names,", ")
 end
 G.normalize=normalize
 function G.reload()
  local v=read(path) or {version=1,mode="Clients only",names="",waitSeconds=20}
  if not valid[v.mode] then v.mode="Clients only" end
  v.names=normalize(v.names) or ""
  v.waitSeconds=math.clamp(math.floor(tonumber(v.waitSeconds) or 20),0,120)
  G.config=v return v
 end
 G.reload()
 function G.configure(key,value)
  G.reload()
  if key=="mode" then if not valid[value] then return false end
  elseif key=="names" then local clean,err=normalize(value) if not clean then G.status=err return false,err end value=clean
  elseif key=="waitSeconds" then value=tonumber(value) if not value then return false end value=math.clamp(math.floor(value),0,120)
  else return false end
  G.config[key]=value G.config.version=1 write(path,G.config)
  G.status="Saved guest access: "..G.config.mode return true
 end
 function G.allowed(name,members)
  name=tostring(name):lower()
  for _,m in ipairs(members or {}) do if m.name:lower()==name then return true end end
  if G.config.mode=="Anyone" then return true end
  if G.config.mode=="Named guests" then for guest in G.config.names:gmatch("[^, ]+") do if guest:lower()==name then return true end end end
  return false
 end
 local function find(parent,name)
  for _,v in ipairs(parent:GetChildren()) do if v.Name:lower()==name:lower() then return v end end
 end
 local function fire(name,...)
  if C.Fire then return C.Fire(name,...) end
  game.ReplicatedStorage.remotes[name]:FireServer(...)
 end
 local function invoke(name,...)
  if C.Invoke then return C.Invoke(name,...) end
  return game.ReplicatedStorage.remotes[name]:InvokeServer(...)
 end
 local function action(key,seconds,fn)
  if now()-(G.actions[key] or -math.huge)<seconds then return end
  G.actions[key]=now() return fn()
 end
 local function status(message) G.status=message F.status=message end
 local function partyFor(name)
  local games=workspace:FindFirstChild("games") local root=C.PartyRoot or games and games:FindFirstChild("inLobby")
  return root and root:FindFirstChild(name)
 end
 local baseRequeue=F.workRequeue
 function G.workRequeue(j)
  if not G.alive or not B.alive then return end
  G.reload()
  if G.config.mode=="Clients only" then return baseRequeue(j) end
  -- Keep the same inventory, upgrade and pause barriers as the Sottoro bridge.
  local members=F.members()
  if F.config.cleanupAutoSell then
   for _,m in ipairs(members) do if not m.harvard or not m.harvard.salesReady then status("Finishing protected auto-sell before queue") return end end
  end
  local ready,message=B.allReady(members,true)
  if not ready then status(message) return end
  local safety=B.library and B.library.Toggles and B.library.Toggles["Main/Safety/leaveOnStranger"]
  if safety and safety.Value then status("Turn off Leave on stranger to use guest access") return end
  local owner
  for _,m in ipairs(F.config.roster) do if m.id==j.owner then owner=m break end end
  if not owner then return end
  local party=partyFor(owner.name)
  if P.UserId==j.owner then
   if not party then
    action(j.id..":create",12,function()
     local d=j.destination
     local ok=invoke("createLobby",d.name,d.difficulty,d.level,d.hardcore,G.config.mode~="Anyone",false)
     if ok~=true then status("Dungeon lobby was not created") end
    end)
    return
   end
   local map=party:FindFirstChild("mapName") local private=map and map:FindFirstChild("private")
   if private and private.Value then
    local names={}
    for _,m in ipairs(j.members) do if m.id~=j.owner then names[m.name]=true end end
    -- Resolve canonical names from present players. Anyone also works in an
    -- already-created private lobby by admitting the people currently present.
    for _,player in ipairs(Players:GetPlayers()) do
     if player.UserId~=P.UserId and G.allowed(player.Name,j.members) then names[player.Name]=true end
    end
