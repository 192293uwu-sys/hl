                  fL, jL = pcall(k.gsSpiralR, AL, L, b, HL, NL, lL, AL.tightD or UL, wL)
                  if not fL then
                    N.lastError = "gs spiral: " .. tostring(jL)
                    N.lastErrorAt = b
                  end
                  if fL then
                    if AL.spiralOn then
                      if N.runOn then
                        if k.gsSpiralRunOnOff then
                          DL, sL = pcall(k.gsSpiralRunOnOff, b)
                          if not DL then
                            N.lastError = "gs spiral run-on: " .. tostring(sL)
                            N.lastErrorAt = b
                          end
                        end
                      end
                    end
                  end
                end
              end
            end
          end
          if
            H.gspNextGroup ~= false
            and AL.phase == "fight"
            and k.tagTarget
            and k.nextUntagged
            and not m
            and not AL.spiralOn
            and not k.gsInBeams(y, L.X, L.Y, L.Z, H.gspBeamIn or 2.5)
          then
            DL = true
            for nL, nL in ipairs(HL) do
              if k.tagTarget(nL) then
                DL = false
                break
              end
            end
            if DL then
              jL = k.nextUntagged(L.X, L.Z)
              if jL then
                if (jL.x - NL) ^ 2 + (jL.z - lL) ^ 2 > (H.gspNextApart or 25) ^ 2 then
                  iL, eL = jL.x - L.X, jL.z - L.Z
                  fL = math.sqrt(iL * iL + eL * eL)
                  if fL > 8 then
                    T = math.min(fL - 6, H.gspStep or 12)
                    kL, sL =
                      Vector3.new(L.X + iL / fL * T, L.Y, L.Z + eL / fL * T),
                      ("GS PLAN: group tagged - on to the next group (%d mob%s, %.0f studs)"):format(
                        jL.n,
                        jL.n == 1 and "" or "s",
                        fL
                      )
                    local nL, qL, oL, rL, KL = aL(kL, sL, true, false)
                    if nL then
                      return nL, qL, oL, rL, KL
                    end
                    if k.gsGapStep then
                      KL = k.gsGapStep(L, Vector3.new(jL.x, L.Y, jL.z), E, vL)
                      if KL then
                        return KL, vL, sL .. " - round what is in the way", true, false
                      end
                    end
                  end
                end
              end
            end
          end
          local nL = H.gspOrbitTight ~= false and (H.gspOrbitWallM or 8) or (H.gspWallMargin or 5)
          local function qL()
            local oL, rL = k.gsOrbitPath(xL, NL, lL, UL, nL, L.Y)
            local KL = #oL
            local LL, bL = math.huge, 1
            for IL = 1, KL, 1 do
              local zL = (oL[IL].X - L.X) ^ 2 + (oL[IL].Z - L.Z) ^ 2
              if zL < LL then
                LL, bL = zL, IL
              else
              end
            end
            if H.gspCornerUnstick ~= false then
              if (N.stalledFor or 0) > (H.gspCornerStuck or 0.8) then
                if not AL.cornerUntil then
                  if b - (AL.cornerAt or -math.huge) > (H.gspCornerEvery or 2) then
                    AL.cornerUntil = b + (H.gspCornerOutFor or 1)
                    AL.cornerAt = b
                    AL.cornerTo = nil
                  end
                end
              end
              if AL.cornerUntil then
                if b > AL.cornerUntil then
                  AL.cornerUntil = nil
                  AL.cornerTo = nil
                end
              end
              if AL.cornerUntil then
                if not AL.cornerTo then
                  local IL, zL = NL - L.X, lL - L.Z
                  local dL = math.sqrt(IL * IL + zL * zL)
                  if dL < 1 then
                    IL, zL, dL = 1, 0, 1
                  else
                  end
                  IL /= dL
                  zL /= dL
                  local dL, YL = H.gspCornerOutLen or 12, { 0, 30, -30, 60, -60 }
                  for FL, CL in ipairs(YL) do
                    FL = math.rad(CL)
                    local YL, CL =
                      IL * math.cos(FL) - zL * math.sin(FL), IL * math.sin(FL) + zL * math.cos(FL)
                    FL = Vector3.new(L.X + YL * dL, L.Y, L.Z + CL * dL)
                    if E(L, FL, vL) then
                      AL.cornerTo = FL
                      break
                    end
                  end
                  AL.cornerTo = AL.cornerTo or Vector3.new(L.X + IL * dL, L.Y, L.Z + zL * dL)
                end
                return AL.cornerTo,
                  "GS PLAN: out of the corner toward the orbit's middle (stuck there)"
              end
            end
            local IL = AL.spiralOn
            if
              H.gspCoverMove ~= false
              and k.gsAttackReady
              and k.gsAttackArea
              and #HL > 0
              and not IL
              and k.gsAttackReady()
            then
              local zL = k.gsAttackArea()
              if zL and zL.place and zL.x and not zL.round then
                local dL, YL = 0, 0
                for FL, FL in ipairs(HL) do
                  dL += FL.x
                  YL += FL.z
                end
                dL /= #HL
                YL /= #HL
                local FL = H.gspCoverMargin or 2
                local CL = (zL.z or zL.x) * 0.5
                local function QL(OL)
                  local gL, VL = dL - OL.X, YL - OL.Z
                  local pL = math.sqrt(gL * gL + VL * VL)
                  if pL < 1 then
                    return false
                  end
                  gL /= pL
                  VL /= pL
                  for pL, tL in ipairs(HL) do
                    local ML, WL, GL = tL.x - OL.X, tL.z - OL.Z, tL.extent or 0
                    pL, tL = ML * gL + WL * VL, math.abs(-ML * VL + WL * gL)
                    if pL - GL > zL.place + CL - FL then
                      return false
                    elseif pL + GL < zL.place - CL + FL then
                      return false
                    elseif tL - GL > zL.x * 0.5 - FL then
                      return false
                    end
                  end
                  return true
                end
                local function zL(FL)
                  local CL = math.huge
                  for OL, OL in ipairs(HL) do
                    CL = math.min(
                      CL,
                      math.sqrt((OL.x - FL.X) ^ 2 + (OL.z - FL.Z) ^ 2) - (OL.extent or 0)
                    )
                  end
                  return CL
                end
                if not (QL(L)) then
                  local FL, CL = dL - L.X, YL - L.Z
                  local dL = math.sqrt(FL * FL + CL * CL)
                  if dL > 4 then
                    FL /= dL
                    CL /= dL
                    local YL = 3
                    while YL <= dL - 4 do
                      local dL = Vector3.new(L.X + FL * YL, L.Y, L.Z + CL * YL)
                      if zL(dL) < (H.gspCoverMinD or 24) then
                        break
                      end
                      if QL(dL) then
                        if E(L, dL, vL) then
                          N.gsCoverMoveAt = b
                          local zL = #HL
                          return dL,
                            ("GS PLAN: closer in so the attack takes in all %d (%.0f studs)"):format(
                              zL,
                              YL
                            )
                        end
                        break
                      end
                      YL += 3
                    end
                  end
                end
              end
            end
            local zL
            if k.gsPathAdjust then
              oL = k.gsPathAdjust(oL, rL, bL, NL, lL, vL)
              zL = oL
            else
              zL = oL
            end
            if H.gspBackToOrbit ~= false and math.sqrt(LL) > (H.gspToOrbitOff or 6) then
              if
                AL.spiral
                and H.gspSpiral ~= false
                and H.gspSpiralEntry ~= false
                and k.gsSpiralEntry
              then
                local oL, dL = pcall(k.gsSpiralEntry, L, NL, lL, zL, AL.dir or 1)
                if oL and dL then
                  for YL, FL in ipairs(dL) do
                    YL = zL[FL]
                    if _(L, YL) > 2 then
                      if E(L, YL, vL) then
                        FL = f[87](_(L, YL))
                        return YL,
                          ("GS PLAN: onto the orbit along it, the way round - not straight in at them (%.0f studs)"):format(
                            f:nL(FL)
                          )
                      end
                    end
                  end
                elseif oL then
                else
                  N.lastError = "gs spiral entry: " .. tostring(dL)
                  N.lastErrorAt = b
                end
              end
              local oL, dL, YL = {}, bL, 0
              for FL = 1, KL - 1, 1 do
                FL = (dL - 1 - (AL.dir or 1)) % KL + 1
                YL += _(zL[dL], zL[FL])
                if YL > (H.gsOrbitBehindLen or 30) then
                  break
                end
                oL[FL] = true
                dL = FL
              end
              oL = if H.gspBackAll ~= false then {} else oL
              dL = {}
              for YL = 1, KL, 1 do
                if not oL[YL] then
                  dL[#dL + 1] = YL
                end
              end
              table.sort(dL, function(oL, YL)
                return (zL[oL].X - L.X) ^ 2 + (zL[oL].Z - L.Z) ^ 2
                  < (zL[YL].X - L.X) ^ 2 + (zL[YL].Z - L.Z) ^ 2
              end)
              local oL, YL
              for FL = 1, math.min(#dL, H.gspBackTries or 16), 1 do
                IL = zL[dL[FL]]
                FL = _(L, IL)
                if FL > 2 then
                  if E(L, IL, vL) then
                    oL, YL = IL, FL
                    break
                  end
                end
              end
              local FL, CL
              if H.gspToOrbitSide == true then
                if k.gsBeamsShooting then
                  if k.gsShooterAxis then
                    if k.gsBeamsShooting(L.X, L.Z, b) then
                      FL, CL = k.gsShooterAxis(L.X, L.Z)
                    else
                    end
                  else
                  end
                else
                end
              else
              end
              if FL and oL then
                local QL = math.cos(math.rad(H.gsBeamSideBanDeg or 50))
                for OL = 1, math.min(#dL, H.gspBackTries or 16), 1 do
                  local gL = zL[dL[OL]]
                  local VL, pL = gL.X - L.X, gL.Z - L.Z
                  OL = math.sqrt(VL * VL + pL * pL)
                  if OL > YL + (H.gspBackSideSlack or 15) then
                    break
                  end
                  if OL > 2 then
                    if math.abs((VL * FL + pL * CL) / OL) <= QL then
                      if E(L, gL, vL) then
                        return gL,
                          ("GS PLAN: back onto the orbit by the nearest clear way (%.0f studs)"):format(
                            OL
                          )
                      end
                    end
                  end
                end
              end
              if oL then
                return oL,
                  ("GS PLAN: back onto the orbit by the nearest clear way (%.0f studs)"):format(YL)
              end
              if H.gspBackBend ~= false then
                local oL, YL = math.huge
                for FL = 1, math.min(#dL, 6), 1 do
                  local CL = zL[dL[FL]]
                  local dL, QL = CL.X - L.X, CL.Z - L.Z
                  FL = math.sqrt(dL * dL + QL * QL)
                  if FL > 2 then
                    dL /= FL
                    QL /= FL
                    local OL = { 8, -8, 16, -16, 24, -24 }
                    for gL, VL in ipairs(OL) do
                      gL = Vector3.new(
                        L.X + dL * FL * 0.5 - QL * VL,
                        L.Y,
                        L.Z + QL * FL * 0.5 + dL * VL
                      )
                      VL = _(L, gL) + _(gL, CL)
                      if VL < oL then
                        if E(L, gL, vL) then
                          if E(gL, CL, vL) then
                            oL, YL = VL, gL
                          else
                          end
                        else
                        end
                      else
                      end
                    end
                  else
                  end
                end
                if YL then
                  return YL,
                    ("GS PLAN: back onto the orbit round what is in the way (%.0f studs)"):format(
                      oL
                    )
                end
              end
            end
            local oL, dL, YL, FL = AL.free or {}, H.gspNoRoom or 20, { 1, -1 }, false
            for CL, QL in ipairs(YL) do
              CL = (AL.past or {})[QL]
              FL = if CL
                then if (CL.room or 0) >= math.min(dL, H.gspPastRoom or 25) then true else FL
                else FL
            end
            if H.gspBackOff ~= false then
              if k.gsOpenSpot then
                if (oL[1] or 99) < dL then
                  if (oL[-1] or 99) < dL then
                    if not (FL and H.gspPastIsRoom ~= false) then
                      YL, IL = pcall(k.gsOpenSpot, L, b, HL, wL, E, vL, AL)
                      if YL and IL then
                        return IL,
                          _(L, IL) < 3
                              and "GS PLAN: no room to orbit - on open ground, fighting from here"
                            or ("GS PLAN: no room to orbit - backing off to open ground (%.0f studs)"):format(
                              _(L, IL)
                            )
                      elseif YL then
                      else
                        N.lastError = "gs open spot: " .. tostring(IL)
                        N.lastErrorAt = b
                      end
                    end
                  end
                end
              end
            end
            dL, oL, YL, IL = AL.free or {}, AL.past or {}, H.gspTightRoom or 15, false
            if H.gspRoomierLast ~= false and H.gspRoundObstacle ~= false then
              if (dL[1] or 99) < YL then
                if (dL[-1] or 99) < YL then
                  if H.gspToOrbitGood ~= false and k.dangerAt then
                    local FL = H.gspToOrbitPath or 25
                    local CL = H.gspFreeDanger or 0.3
                    local function QL(OL, gL)
                      local VL, pL = ipairs, { AL.dir or 1, -(AL.dir or 1) }
                      for tL, tL in VL(pL) do
                        local VL, pL, ML = OL, 0, true
                        for OL = 1, KL, 1 do
                          OL = (VL - 1 + tL) % KL + 1
                          pL += _(zL[VL], zL[OL])
                          local tL, WL, GL = gL + pL / vL, zL[OL], ML
                          if
                            math.max(
                              k.dangerAt(WL.X, WL.Y, WL.Z, tL),
                              k.dangerAt(WL.X, WL.Y, WL.Z, tL + 0.6)
                            ) >= CL
                          then
                            VL, ML = OL, false
                            break
                          end
                          if pL >= FL then
                            VL, ML = OL, GL
                            break
                          end
                          VL = OL
                        end
                        if ML then
                          return true
                        end
                      end
                      return false
                    end
                    local FL = AL.toOrbit
                    if FL then
                      if b - FL.at < (H.gspToOrbitKeep or 1.5) then
                        if FL.k <= KL then
                          if _(L, zL[FL.k]) > 2 then
                            local CL = zL[FL.k]
                            if E(L, CL, vL) then
                              if QL(FL.k, _(L, CL) / vL) then
                                local OL = f[87](_(L, CL))
                                return CL,
                                  ("GS PLAN: to the orbit where it runs clear (%.0f studs, kept) - then round it"):format(
                                    f:nL(OL)
                                  )
                              end
                            end
                          end
                        end
                      end
                    end
                    AL.toOrbit = nil
                    FL = {}
                    for CL = 1, KL, 1 do
                      FL[CL] = CL
                    end
                    table.sort(FL, function(CL, OL)
                      return (zL[CL].X - L.X) ^ 2 + (zL[CL].Z - L.Z) ^ 2
                        < (zL[OL].X - L.X) ^ 2 + (zL[OL].Z - L.Z) ^ 2
                    end)
                    local CL, OL
                    if H.gspToOrbitSide == true and k.gsBeamsShooting then
                      if k.gsShooterAxis then
                        if k.gsBeamsShooting(L.X, L.Z, b) then
                          CL, OL = k.gsShooterAxis(L.X, L.Z)
                        else
                        end
                      else
                      end
                    else
                    end
                    local gL = math.cos(math.rad(H.gsBeamSideBanDeg or 50))
                    for VL = 1, 2, 1 do
                      if VL == 2 or CL then
                        for pL = 1, math.min(KL, H.gspToOrbitGoodTries or 24), 1 do
                          local tL = FL[pL]
                          pL = zL[tL]
                          local FL, ML = pL.X - L.X, pL.Z - L.Z
                          local WL = math.sqrt(FL * FL + ML * ML)
                          if WL > 3 and (VL == 2 or math.abs((FL * CL + ML * OL) / WL) <= gL) then
                            if E(L, pL, vL) then
                              if QL(tL, WL / vL) then
                                AL.toOrbit = { k = tL, at = b }
                                return pL,
                                  ("GS PLAN: to the orbit where it runs clear%s (%.0f studs) - then round it"):format(
                                    VL == 1 and ", sideways to the shooters" or "",
                                    WL
                                  )
                              end
                            end
                          end
                        end
                      end
                    end
                  end
                  if math.sqrt(LL) > (H.gspToOrbitOff or 6) then
                    local LL = {}
                    for FL = 1, KL, 1 do
                      LL[FL] = FL
                    end
                    table.sort(LL, function(FL, CL)
                      return (zL[FL].X - L.X) ^ 2 + (zL[FL].Z - L.Z) ^ 2
                        < (zL[CL].X - L.X) ^ 2 + (zL[CL].Z - L.Z) ^ 2
                    end)
                    local FL, CL
                    if H.gspToOrbitSide == true and k.gsBeamsShooting then
                      if k.gsShooterAxis then
                        if k.gsBeamsShooting(L.X, L.Z, b) then
                          FL, CL = k.gsShooterAxis(L.X, L.Z)
                        else
                        end
                      else
                      end
                    else
                    end
                    if FL then
                      local QL = math.cos(math.rad(H.gsBeamSideBanDeg or 50))
                      for OL = 1, math.min(KL, H.gspToOrbitSideTries or 32), 1 do
                        local gL = zL[LL[OL]]
                        local VL, pL = gL.X - L.X, gL.Z - L.Z
                        OL = math.sqrt(VL * VL + pL * pL)
                        if OL > 1 then
                          if math.abs((VL * FL + pL * CL) / OL) <= QL then
                            if E(L, gL, vL) then
                              return gL,
                                ("GS PLAN: to the orbit sideways to the shooters (a clear way, %.0f studs) - then round it"):format(
                                  OL
                                )
                            end
                          end
                        end
                      end
                    end
                    for FL = 1, math.min(KL, H.gspToOrbitTries or 16), 1 do
                      local CL = zL[LL[FL]]
                      if E(L, CL, vL) then
                        FL = f[87](_(L, CL))
                        return CL,
                          ("GS PLAN: to the orbit (a clear way, %.0f studs) - then round it"):format(
                            f:nL(FL)
                          )
                      end
                    end
                  end
                  local LL, FL = { 1, -1 }, IL
                  for CL, QL in ipairs(LL) do
                    local LL, OL = ipairs, { H.gspStep or 12, 7, 4 }
                    for gL, VL in LL(OL) do
                      gL, CL = 0, bL
                      for LL = 1, KL, 1 do
                        if gL >= VL then
                          break
                        end
                        LL = (CL - 1 + QL) % KL + 1
                        gL, CL = gL + _(zL[CL], zL[LL]), LL
                      end
                      if E(L, zL[CL], vL) then
                        FL = true
                        break
                      end
                    end
                    if FL then
                      break
                    end
                  end
                  IL = FL
                else
                end
              else
              end
            else
            end
            if
              (if IL then not IL else H.gspRoundObstacle ~= false)
              and (dL[1] or 99) < YL
              and (dL[-1] or 99) < YL
            then
              local LL, FL, CL = { 1, -1 }, -1
              for QL, OL in ipairs(LL) do
                QL = oL[OL]
                if QL then
                  if QL.room > FL then
                    local gL = QL.room
                    FL, CL = gL, OL
                  else
                  end
                else
                end
              end
              CL = if H.gspHoldSense ~= false and oL[AL.dir or 1]
                then AL.dir or 1
                else if H.gspHoldSense ~= false
                  then if k.gsTurnBackOn() then nil else CL
                  else CL
              if
                AL.roomSg
                and b - (AL.roomAt or -math.huge) < (H.gspToOrbitKeep or 1.5)
                and oL[AL.roomSg]
                and H.gspHoldSense == false
              then
                CL = AL.roomSg
              else
                if CL then
                  AL.roomSg = CL
                  AL.roomAt = b
                end
              end
              if CL then
                LL = zL[oL[CL].k]
                local FL, QL = LL.X - L.X, LL.Z - L.Z
                local OL = math.sqrt(FL * FL + QL * QL)
                if OL > 1 then
                  FL /= OL
                  QL /= OL
                  local gL
                  local VL = math.huge
                  if E(L, LL, vL) then
                    gL, VL = LL, OL
                  else
                  end
                  local pL = { 10, -10, 20, -20, 30, -30, 40, -40 }
                  for tL, ML in ipairs(pL) do
                    tL =
                      Vector3.new(L.X + FL * OL * 0.5 - QL * ML, L.Y, L.Z + QL * OL * 0.5 + FL * ML)
                    ML = _(L, tL) + _(tL, LL)
                    if ML < VL then
                      if E(L, tL, vL) then
                        if E(tL, LL, vL) then
                          VL, gL = ML, tL
                        else
                        end
                      else
                      end
                    else
                    end
                  end
                  gL = gL
                    or (
                      if H.gspGapWalk ~= false
                        then if k.gsGapStep then k.gsGapStep(L, LL, E, vL) else gL
                        else gL
                    )
                  if gL then
                    if CL ~= (AL.dir or 1) then
                      AL.dirAt = b
                    end
                    AL.dir = CL
                    return gL, "GS PLAN: round the attack to the side of the orbit with more path"
                  end
                end
              end
            end
            dL = AL.stuckMemo
            if H.gspStuckMemo ~= false then
              if dL then
                if b - dL.at >= 0 then
                  if b - dL.at < (H.gspStuckMemoFor or 0.25) then
                    if dL.gen == (K.boxGen or 0) then
                      if (L.X - dL.x) ^ 2 + (L.Z - dL.z) ^ 2 < 4 then
                        if dL.q then
                          return dL.q, dL.lab
                        end
                        return nil
                      end
                    end
                  end
                end
              end
            end
            if H.gspStuckKeep ~= false then
              if dL then
                if dL.q then
                  if b - dL.at >= 0 then
                    if b - dL.at < (H.gspStuckKeepFor or 0.6) then
                      if (L.X - dL.x) ^ 2 + (L.Z - dL.z) ^ 2 < 9 then
                        if E(L, dL.q, vL) then
                          return dL.q, dL.lab
                        end
                      end
                    end
                  end
                end
              end
            end
            dL, YL = {}, { 1, -1 }
            for LL, FL in ipairs(YL) do
              oL, LL = ipairs, { H.gspStep or 12, 7, 4 }
              for CL, QL in oL(LL) do
                CL, IL = 0, bL
                for LL = 1, KL, 1 do
                  if CL >= QL then
                    break
                  end
                  LL = (IL - 1 + FL) % KL + 1
                  CL, IL = CL + _(zL[IL], zL[LL]), LL
                end
                QL, CL = zL[IL]
                for LL, OL in ipairs(H.gspShiftTry or { 0, 3, 6, -2, -3.5 }) do
                  local gL, VL = NL - QL.X, lL - QL.Z
                  LL = math.sqrt(gL * gL + VL * VL)
                  local pL = (OL == 0 or LL < 1) and QL
                    or Vector3.new(QL.X + gL / LL * OL, QL.Y, QL.Z + VL / LL * OL)
                  if E(L, pL, vL) then
                    CL = pL
                    break
                  end
                end
                if CL then
                  dL[FL] = { k = IL, q = CL }
                  break
                end
              end
            end
            YL, oL = AL.dir or 1
