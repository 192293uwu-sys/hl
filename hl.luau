    return B.newQueueJob(members)
   end
   if B.replayDecision() and B.finished() then F.status="Replaying dungeon — no useful gear changes" return end
   local ready,message=B.allReady(members,true)
   if not ready then F.status=message return end
   local plan=F.plan(members,F.config.includeExisting~=false)
   if plan then return F.newJob(plan,members) end
   local needsLobby=false local reason
   for _,m in ipairs(members) do
    if m.lobby then needsLobby=true reason="Queueing party from lobby"
    else
     local u=m.harvard and m.harvard.localUpgrade
     if not u or not u.verified then F.status="Waiting for gear comparison on "..m.name return end
     if u.needed then needsLobby=true reason="Affordable upgrade for "..m.name..": "..tostring(u.name) end
    end
   end
   if needsLobby then F.status=reason return B.newQueueJob(members) end
   local run=members[1].job
   for _,m in ipairs(members) do if m.job~=run then F.status="Waiting for the party in the same dungeon" return end end
   write(root.."/replay.json",{job=run,created=now(),count=#members,signature=B.requiredSignature and B.requiredSignature(members)})
