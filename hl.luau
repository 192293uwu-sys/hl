return function(C,B)
 if B.Statistics then return B.Statistics end
 local K=assert(loadstring(readfile("Inv++/harvard_statistics_core.lua"),"Harvard statistics accounting"))()()
 local H=game:GetService("HttpService") local P=game.Players.LocalPlayer local RS=game:GetService("ReplicatedStorage")
 local path="Inv++/harvard_statistics_"..P.UserId..".json"
 local S={alive=true,scope="Session",connections={},rows={},live={},dirty=false,lastScan=0,lastSave=0,frames=0,frameTime=0}
 B.Statistics=S local now=os.time() local state=K.new(now) S.core=K S.path=path
 local function read(file) local ok,v=pcall(function() return H:JSONDecode(readfile(file)) end) if ok then return v end end
 if isfile(path) then
  local ok,v=pcall(K.normalize,read(path),now)
  if ok then state=v else
   local good,backup=pcall(K.normalize,read(path..".bak"),now)
   if good then state=backup S.notice="Recovered saved statistics from the backup."
   else S.readError="Saved statistics could not be read. Tracking is temporary; the original file is preserved." end
  end
 end
 S.state=state
 local function connect(signal,fn) local c=signal:Connect(fn) table.insert(S.connections,c) return c end
 function S.save(force)
  if S.readError or not S.dirty and not force then return end
  local ok,why=pcall(function()
   local body=H:JSONEncode(state)
   if S.lastBody then writefile(path..".bak",S.lastBody) end
   writefile(path,body) S.lastBody=body
  end)
  if ok then S.dirty=false S.saveError=nil S.lastSave=os.clock() else S.saveError="Save failed: "..tostring(why) end
 end
 if not S.readError then S.lastBody=H:JSONEncode(state) end
 local function changed(urgent)
  S.dirty=true
  if urgent and not S.savePending then S.savePending=true task.delay(1,function() S.savePending=false if S.alive then S.save() end end) end
 end
 local function value(parent,name)
  local v=parent and parent:FindFirstChild(name)
  return v and v:IsA("ValueBase") and v.Value or nil
 end
 local function number(parent,name) local n=tonumber(value(parent,name)) return K.finite(n) and n or nil end
 local function stat(key)
  local folder=workspace:FindFirstChild("stats") local part=folder and folder:FindFirstChild(key)
  return number(part,P.Name),part
 end
 local bound=setmetatable({},{__mode="k"})
 local function watch(v,callback)
  if not v or not v:IsA("ValueBase") or bound[v] then return end bound[v]=true
  connect(v:GetPropertyChangedSignal("Value"),function()
   if not S.alive then return end local ok,why=pcall(callback,v.Value)
   if not ok then S.errors=(S.errors or 0)+1 S.lastError=tostring(why) end
  end)
 end
 local function combat(key,n)
  if not K.finite(n) then return end
  local old=state.all[key] K.counter(state,game.JobId,key,n)
  if state.active then state.active[key]=(state.active[key] or 0)+state.all[key]-old end
 end
 local function currentMap() return tostring(value(workspace,"dungeonName") or "Lobby") end
 local function diff()
  local lobby=RS:FindFirstChild("aGame") local map=lobby and lobby:FindFirstChild("mapName")
  for _,v in ipairs({value(map,"difficulty") or "",value(workspace,"difficulty") or "",C.WH and C.WH.run and C.WH.run.difficulty or ""}) do if tostring(v)~="" then return tostring(v) end end
  return "Unknown"
 end
 function S.sample()
  local live=S.live local leader=P:FindFirstChild("leaderstats")
  local dataReady=value(P,"dataLoaded")==true and number(leader,"Level")~=nil
  live.level=number(leader,"Level") live.xp=number(P,"XP") live.needed=number(P,"XPNeeded")
  live.gold=number(leader,"Gold") live.gems=number(leader,"Gems") live.candy=number(P,"Candy")
  if dataReady then
   K.balance(state,"gold",live.gold) K.balance(state,"gems",live.gems) K.balance(state,"candy",live.candy)
   -- Level, XP and XPNeeded replicate separately; wait for two stable snapshots.
   local signature=tostring(live.level)..":"..tostring(live.xp)..":"..tostring(live.needed)
   if S.progressSignature==signature then K.progress(state,live.level,live.xp,live.needed) else S.progressSignature=signature end
  end
  for _,d in ipairs({{leader,"Gold","gold"},{leader,"Gems","gems"},{P,"Candy","candy"}}) do
   local key=d[3] watch(d[1] and d[1]:FindFirstChild(d[2]),function(n)
    if value(P,"dataLoaded")==true then K.balance(state,key,tonumber(n)) changed() end
   end)
  end
  live.server={} live.party={} local names={dealt="dealt",healed="healed",taken="taken"}
  for key,source in pairs(names) do
   local n,folder=stat(source) live.server[key]=n
   local total=0 local found=false
   if folder then for _,v in ipairs(folder:GetChildren()) do if v:IsA("ValueBase") and K.finite(tonumber(v.Value)) then total+=tonumber(v.Value) found=true end end end
   if found then live.party[key]=total end
   if n then combat(key,n) end
   watch(folder and folder:FindFirstChild(P.Name),function(n) combat(key,tonumber(n)) changed() end)
  end
  live.map=currentMap() live.difficulty=diff() live.progress=tostring(value(workspace,"dungeonProgress") or "Unknown")
  live.wave=number(workspace,"currentWave") live.timeLeft=number(workspace,"timeLeft") live.tier=number(workspace,"tier")
  live.started=value(workspace,"dungeonStarted")==true or value(workspace,"start")==true
  live.hardcore=value(workspace,"hardcore") live.free=number(P,"skillPoints") live.warrior=number(P,"physicalPower") live.mage=number(P,"spellPower") live.guardian=number(P,"stamina")
  local char=P.Character local hum=char and char:FindFirstChildOfClass("Humanoid") local root=char and char:FindFirstChild("HumanoidRootPart")
  live.hp=hum and hum.Health live.maxHP=hum and hum.MaxHealth live.speed=hum and hum.WalkSpeed
  live.movingSpeed=root and root.AssemblyLinearVelocity.Magnitude
  pcall(function() live.ping=game:GetService("Stats").Network.ServerStatsItem["Data Ping"]:GetValue() end)
  pcall(function() live.memory=game:GetService("Stats"):GetTotalMemoryUsageMb() end)
  live.farm=C.RT.farmEnabled==true live.attack=C.RT.attackState live.movement=C.RT.movementState
  changed()
 end
 function S.begin(run,partial)
  if not run then return end
  S.failed=false
  if K.begin(state,game.JobId,run.dungeon,run.difficulty,os.time(),partial) then changed(true) end
 end
 function S.finish(run,won)
  if not run or state.finished[game.JobId] then return end
  S.sample()
  if not state.active then S.begin(run,true) end
  local failed=S.failed==true
  if not failed and C.runFailed then local ok,v=pcall(C.runFailed) failed=ok and v==true end
  local gui=P:FindFirstChild("PlayerGui") if gui and gui:FindFirstChild("failedGui") then failed=true end
  local seconds=C.WH and C.WH.runSecs and C.WH.runSecs(run)
  if K.finish(state,game.JobId,won and "wins" or failed and "losses" or "unfinished",seconds,os.time()) then changed(true) end
 end
 function S.kill(boss) K.add(state,boss and "bosses" or "mobs",1) changed() end
 local function watchCharacter(char)
  task.spawn(function()
   local hum=char:FindFirstChildOfClass("Humanoid") or char:WaitForChild("Humanoid",15)
   if not S.alive or not hum or char~=P.Character then return end
   connect(hum.Died,function()
    if not S.alive then return end K.add(state,"deaths",1)
    if state.active then state.active.deaths+=1 if state.active.sessionDeaths then state.active.sessionDeaths+=1 end end changed(true)
   end)
  end)
 end
 connect(P.CharacterAdded,watchCharacter) if P.Character then watchCharacter(P.Character) end
 local remotes=RS:FindFirstChild("remotes") local failed=remotes and remotes:FindFirstChild("loadFailedGui")
 if failed and failed:IsA("RemoteEvent") then connect(failed.OnClientEvent,function() S.failed=true end) end
 connect(P.OnTeleport,function() S.sample() S.save(true) end)
 connect(game:GetService("RunService").RenderStepped,function(dt) S.frames+=1 S.frameTime+=dt end)
 function S.scanLoot()
  local history=B.A.History and B.A.History.store.items or {} local owned={}
  for _,r in pairs(B.A.index or {}) do if r.item and r.item.UniqueItemID then owned[r.item.UniqueItemID]=r end end
  for uid,e in pairs(history) do
   if not state.seenLoot[uid] and e.acquisition=="drop" and e.confirmation=="reward-inventory-match" then
    local record=e.snapshot or owned[uid] local pot
    if record and record.item and B.A.compute then local ok,n=pcall(B.A.compute,record.item,record.kind) if ok and K.finite(n) then pot=n end end
    if K.loot(state,uid,e,record,pot) then changed(true) end
   end
  end
 end
 local function comma(n,decimals)
  if not K.finite(n) then return "Unavailable" end
  local raw=string.format("%."..tostring(decimals or 0).."f",n) local sign,whole,fraction=raw:match("^([%-]?)(%d+)(.*)$")
  return sign..whole:reverse():gsub("(%d%d%d)","%1,"):reverse():gsub("^,","")..fraction
 end
 local function time(n)
  if not K.finite(n) then return "No full clears yet" end n=math.max(0,math.floor(n))
  local h=math.floor(n/3600) return h>0 and string.format("%dh %02dm %02ds",h,math.floor(n/60)%60,n%60) or string.format("%dm %02ds",math.floor(n/60),n%60)
 end
 local function rate(n,seconds) return seconds>=60 and comma(n*3600/seconds) or "Collecting 60s of data" end
 local function count(t) local n=0 for _ in pairs(t or {}) do n+=1 end return n end
 local function date(n) return os.date("%b %d, %Y · %H:%M",n) end
 local function row(parent,label,order,color)
  local ui=C.UIKit local T=ui.Theme
  local f=Instance.new("Frame") f.Name="Statistic_"..label:gsub("[^%w]","") f.BackgroundTransparency=1 f.BorderSizePixel=0 f.Size=UDim2.new(1,0,0,27) f.AutomaticSize=Enum.AutomaticSize.Y f.LayoutOrder=order f.Parent=parent
  local l=Instance.new("TextLabel") l.Name="Label" l.BackgroundTransparency=1 l.Text=label l.TextColor3=T.TextSub l.TextSize=12 l.TextXAlignment=Enum.TextXAlignment.Left l.TextYAlignment=Enum.TextYAlignment.Top l.TextWrapped=true l.Size=UDim2.new(.47,-6,0,20) l.AutomaticSize=Enum.AutomaticSize.Y ui.setFont(l,"sans",Enum.FontWeight.Medium) l.Parent=f
  local v=l:Clone() v.Name="Value" v.Text="—" v.Position=UDim2.new(.47,6,0,0) v.Size=UDim2.new(.53,-6,0,20) v.TextColor3=color or T.TextPrimary v.TextXAlignment=Enum.TextXAlignment.Right ui.setFont(v,"mono",Enum.FontWeight.Medium) v.Parent=f
  return v
 end
 function S.mount()
  local ui=C.UIKit local T=ui.Theme
  local function open(box) local entry=C.sectionReg and C.sectionReg[box.holder] if entry then entry.setOpen(true,true) end end
  local page=C.Shell.page("Statistics","Statistics","Live game counters, this session and locally saved all-time statistics.") S.page=page
  C.Shell.pages.Statistics.tab.icon="bar-chart-3"
  local top=ui.section(page.body,"Statistics",1,"Per account · survives teleports · updates once per second") open(top)
  ui.dropdown(top.content,"View",{{value="Session",label="Session"},{value="All time",label="All time"}},function() return S.scope end,function(v) S.scope=v S.render() end,1)
  S.coverage=ui.caption(top.content,"",2)
  local buttons=ui.buttonRow(top.content,3)
  buttons.add("Copy report","subtle",function()
   local report={version=C.SCRIPT_VERSION,account=P.Name,userId=P.UserId,exportedAt=os.time(),coverage="Locally observed totals; prior confirmed Inv++ loot imported separately",data=state,live=S.live}
   local ok=pcall(function() setclipboard(H:JSONEncode(report)) end)
   S.notice=ok and "Statistics report copied." or "Clipboard unavailable." S.render()
  end)
  local resetButton
  resetButton=buttons.add("New session","subtle",function()
   if not S.resetUntil or os.clock()>S.resetUntil then S.resetUntil=os.clock()+5 resetButton.Text="Confirm new session" return end
   state.session={since=os.time(),last=os.time(),data=K.aggregate()}
   if state.active then state.active.sessionPartial=true state.active.sessionDeaths=0 end
   S.resetUntil=nil resetButton.Text="New session" changed(true) S.render()
  end)
  S.resetButton=resetButton
  local sections={
   {"Run performance","Only verified game outcomes count as wins or losses. Leaving a run is unfinished.",{
    "Runs recorded","Wins","Losses","Unfinished runs","Clear rate","Average full clear","Fastest full clear","Slowest full clear","Full clears timed","Deathless full clears","Current win streak","Best win streak","Own deaths","Deaths per completed run","Wins per active hour"}},
   {"Progression & currency","Balance increases and decreases include all sources, including trades, purchases, sales and upgrades.",{
    "XP gained (verified)","Levels gained","XP sampling gaps","XP per active hour","Gold increases","Gold decreases","Gold net change","Gold net per active hour","Gems increases","Gems decreases","Gems net change","Candy increases","Candy decreases"}},
   {"Combat","Server counters for your username. Observed mob and boss deaths are shared encounter events, not personal kill credit.",{
    "Damage dealt","Damage taken","Healing done","Damage per dungeon second","Healing per dungeon second","Observed mob deaths","Observed boss deaths","Damage / damage taken"}},
   {"Confirmed loot","Reward-to-inventory matches only. First-seen items and received trades are excluded. Potential uses Inv++'s verified item tables.",{
    "Confirmed drops","Imported earlier drops","Unique item names","Weapons","Helmets","Armor","Spells","Common","Uncommon","Rare","Epic","Legendary","Ultimate","Unknown rarity","90%+ Godpot","95%+ Godpot","99.95%+ Godpot","Average known Godpot","Best known Godpot","Drops per active hour"}},
   {"Activity & client performance","Active observed time excludes closed-client time and teleport downtime. FPS is sampled in one-second windows.",{
    "Tracked online time","Farming enabled time","Active dungeon time","Time outside active runs","Alive time","Average measured ping","Lowest / highest ping","Average sampled FPS","Lowest / highest FPS"}},
   {"Live account","Values currently replicated by the game. Unavailable sources are shown explicitly.",{
    "Account / class","Level","XP progress","XP to next level","ETA to next level","Gold balance","Gems balance","Candy balance","Unspent skill points","Warrior / Mage / Guardian points","Health","Walk speed / movement","Measured ping","Client FPS / frame time","Client memory","Owned inventory items","Equipped weapon"}},
   {"Current dungeon","Current server counters include the whole round available on this client, even when attached partway through.",{
    "Dungeon / difficulty","Progress","Run state","Time remaining","Wave / boss-key tier","Server damage dealt","Server damage taken","Server healing","Party damage share","Players in this server","Harvard attack state","Harvard movement state"}},
  }
  for i,def in ipairs(sections) do
   local box=ui.section(page.body,def[1],i+1,def[2]) if i==1 then open(box) end
   for order,name in ipairs(def[3]) do
    local color=name:find("Gold") and Color3.fromRGB(238,199,91) or name:find("XP") and Color3.fromRGB(192,150,238) or name:find("Healing") and Color3.fromRGB(137,210,151) or nil
    S.rows[name]=row(box.content,name,order,color)
   end
  end
  local maps=ui.section(page.body,"By dungeon & difficulty",10,"Recorded outcomes and full-clear timings for the selected view.")
  S.maps=ui.caption(maps.content,"No recorded runs yet.",1)
  local recent=ui.section(page.body,"Recent runs",11,"Newest first · most recent 100 stored · latest 12 displayed")
  S.recent=ui.caption(recent.content,"No recorded runs yet.",1)
  local sources=ui.section(page.body,"Data coverage",12,"Reliable sources and limits")
  ui.caption(sources.content,"Damage / healing: workspace.stats.dealt, taken and healed, keyed by username, exactly as DQR's player leaderboard reads them. Progression: player XP / XPNeeded and leaderstats. Outcomes: Harvard's native run detector, checked against the game's failure state. Deaths: your Humanoid.Died. Loot: confirmed Inv++ reward matches. No server-lifetime wins, hidden drop probabilities, sale proceeds or spell-hit counts are fabricated. All-time means this account's saved observation history, not the entire Roblox account lifetime.",1)
  S.status=ui.caption(sources.content,"",2)
 end
 function S.render()
  if not S.page then return end
  local a=S.scope=="Session" and state.session.data or state.all local l=S.live local completed=a.wins+a.losses
  local function put(name,v) if S.rows[name] then S.rows[name].Text=tostring(v) end end
  local function n(name,key) put(name,comma(a[key])) end
  S.coverage.Text=(S.scope=="Session" and "Session since "..date(state.session.since) or "All-time observations since "..date(state.since)).."\n"..(S.readError or S.saveError or S.notice or "Saved locally on this account. All-time loot also includes older confirmed Inv++ history.")
  n("Runs recorded","runs") n("Wins","wins") n("Losses","losses") n("Unfinished runs","unfinished")
  put("Clear rate",completed>0 and string.format("%.1f%%",a.wins/completed*100) or "No completed runs")
  put("Average full clear",a.timedWins>0 and time(a.clearSeconds/a.timedWins) or "No full clears yet")
  put("Fastest full clear",time(a.fastest)) put("Slowest full clear",time(a.slowest)) n("Full clears timed","timedWins") n("Deathless full clears","deathless")
  n("Current win streak","streak") n("Best win streak","bestStreak") n("Own deaths","deaths")
  put("Deaths per completed run",completed>0 and comma(a.completedDeaths/completed,2) or "No completed runs") put("Wins per active hour",rate(a.wins,a.online))
  n("XP gained (verified)","xp") n("Levels gained","levels") n("XP sampling gaps","xpGaps") put("XP per active hour",rate(a.xp,a.online))
  for _,v in ipairs({{"Gold increases","goldIn"},{"Gold decreases","goldOut"},{"Gems increases","gemsIn"},{"Gems decreases","gemsOut"},{"Candy increases","candyIn"},{"Candy decreases","candyOut"}}) do n(v[1],v[2]) end
  put("Gold net change",comma(a.goldIn-a.goldOut)) put("Gold net per active hour",rate(a.goldIn-a.goldOut,a.online)) put("Gems net change",comma(a.gemsIn-a.gemsOut))
  n("Damage dealt","dealt") n("Damage taken","taken") n("Healing done","healed")
  put("Damage per dungeon second",a.dungeon>0 and comma(a.dealt/a.dungeon) or "No active dungeon time") put("Healing per dungeon second",a.dungeon>0 and comma(a.healed/a.dungeon) or "No active dungeon time")
  n("Observed mob deaths","mobs") n("Observed boss deaths","bosses") put("Damage / damage taken",a.taken>0 and comma(a.dealt/a.taken,2).."x" or "No damage taken")
  n("Confirmed drops","drops") n("Imported earlier drops","importedDrops") put("Unique item names",comma(count(a.names)))
  for _,v in ipairs({{"Weapons","weapon"},{"Helmets","helmet"},{"Armor","chest"},{"Spells","ability"}}) do put(v[1],comma(a.kinds[v[2]] or 0)) end
  for _,v in ipairs({"Common","Uncommon","Rare","Epic","Legendary","Ultimate"}) do put(v,comma(a.rarities[v:lower()] or 0)) end
  put("Unknown rarity",comma(a.rarities.unknown or 0)) n("90%+ Godpot","high90") n("95%+ Godpot","high95") n("99.95%+ Godpot","perfect")
  put("Average known Godpot",a.potCount>0 and string.format("%.2f%% (%s items)",a.potSum/a.potCount,comma(a.potCount)) or "No known gear potentials")
  put("Best known Godpot",a.bestPot and string.format("%.2f%% · %s",a.bestPot.value,a.bestPot.name) or "No known gear potentials")
  local newDrops=math.max(0,a.drops-a.importedDrops) put("Drops per active hour",rate(newDrops,a.online))
  put("Tracked online time",time(a.online)) put("Farming enabled time",time(a.farming)) put("Active dungeon time",time(a.dungeon)) put("Time outside active runs",time(a.online-a.dungeon)) put("Alive time",time(a.alive))
  put("Average measured ping",a.pingN>0 and comma(a.pingSum/a.pingN,1).." ms" or "Unavailable")
  put("Lowest / highest ping",a.pingN>0 and comma(a.pingMin).." / "..comma(a.pingMax).." ms" or "Unavailable")
  put("Average sampled FPS",a.fpsN>0 and comma(a.fpsSum/a.fpsN,1) or "Unavailable") put("Lowest / highest FPS",a.fpsN>0 and comma(a.fpsMin).." / "..comma(a.fpsMax) or "Unavailable")
  put("Account / class",P.DisplayName.." · "..tostring(C.CFG.classProfile)) put("Level",comma(l.level))
  put("XP progress",l.xp and l.needed and l.needed>0 and comma(l.xp).." / "..comma(l.needed)..string.format(" (%.1f%%)",l.xp/l.needed*100) or "Unavailable")
  put("XP to next level",l.xp and l.needed and comma(math.max(0,l.needed-l.xp)) or "Unavailable")
  local ses=state.session.data
  put("ETA to next level",l.xp and l.needed and ses.xp>0 and ses.online>=60 and time(math.max(0,l.needed-l.xp)*ses.online/ses.xp).." (observed rate)" or "Collecting XP samples")
  put("Gold balance",comma(l.gold)) put("Gems balance",comma(l.gems)) put("Candy balance",comma(l.candy)) put("Unspent skill points",comma(l.free))
  put("Warrior / Mage / Guardian points",comma(l.warrior).." / "..comma(l.mage).." / "..comma(l.guardian))
  put("Health",comma(l.hp).." / "..comma(l.maxHP)) put("Walk speed / movement",comma(l.speed,1).." / "..comma(l.movingSpeed,1).." studs/s")
  put("Measured ping",comma(l.ping,1).." ms") put("Client FPS / frame time",l.fps and comma(l.fps,1).." / "..comma(1000/math.max(1,l.fps),2).." ms" or "Collecting frames") put("Client memory",comma(l.memory,1).." MB")
  put("Owned inventory items",comma(count(B.A.index))) put("Equipped weapon",tostring(value(P,"weaponEquipped") or "Unavailable"))
  put("Dungeon / difficulty",l.map.." · "..l.difficulty) put("Progress",l.progress~="" and l.progress or "Waiting") put("Run state",state.active and "Running" or l.started and "Waiting for run detector" or "Waiting / lobby")
  put("Time remaining",l.timeLeft and time(l.timeLeft) or "Unavailable") put("Wave / boss-key tier",comma(l.wave).." / "..comma(l.tier))
  put("Server damage dealt",comma(l.server and l.server.dealt)) put("Server damage taken",comma(l.server and l.server.taken)) put("Server healing",comma(l.server and l.server.healed))
  put("Party damage share",l.server and l.server.dealt and l.party.dealt and l.party.dealt>0 and string.format("%.2f%%",l.server.dealt/l.party.dealt*100) or "No server damage yet")
  put("Players in this server",#game.Players:GetPlayers()) put("Harvard attack state",l.attack or "Unavailable") put("Harvard movement state",l.movement or "Unavailable")
  local maps={} for name,m in pairs(a.maps) do table.insert(maps,{name=name,data=m}) end table.sort(maps,function(x,y) return x.data.runs>y.data.runs end)
  local lines={} for i,m in ipairs(maps) do if i>20 then break end local d=m.data
   table.insert(lines,m.name.."\n"..comma(d.wins).." W · "..comma(d.losses).." L · "..comma(d.unfinished).." unfinished · "..comma(d.deaths).." deaths\nFastest "..time(d.fastest).." · Avg "..(d.timed>0 and time(d.seconds/d.timed) or "—"))
  end S.maps.Text=#lines>0 and table.concat(lines,"\n\n") or "No recorded runs yet."
  local recent={} for _,r in ipairs(state.recent) do if S.scope=="All time" or r.ended>=state.session.since then
   table.insert(recent,date(r.ended).." · "..r.map.." · "..r.difficulty.."\n"..({wins="WIN",losses="LOSS",unfinished="UNFINISHED"})[r.result].." · "..(r.seconds and time(r.seconds) or "Time unavailable").." · "..r.deaths.." deaths"..(r.partial and " · partial observation" or "")) if #recent>=12 then break end
  end end S.recent.Text=#recent>0 and table.concat(recent,"\n\n") or "No recorded runs yet."
  S.status.Text=(S.readError or S.saveError or "Storage: "..path).."\n".."Tracked outcomes: "..comma(count(state.finished)).." · confirmed unique drop IDs: "..comma(count(state.seenLoot)).." · refresh errors: "..comma(S.errors or 0)
 end
 function S.destroy()
  if not S.alive then return end S.alive=false S.save(true)
  for _,c in ipairs(S.connections) do c:Disconnect() end S.connections={}
 end
 if state.active then
  if state.active.key~=game.JobId then K.finish(state,state.active.key,"unfinished",nil,os.time())
  else state.active.partial=true end -- Harvard's native stopwatch restarts after reinjection.
 end
 S.sample() S.scanLoot()
 if C.WH and C.WH.run then S.begin(C.WH.run,true) end
