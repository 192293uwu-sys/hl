  else
   local map=party and party:FindFirstChild("mapName") local private=map and map:FindFirstChild("private")
   if party and private and (not private.Value or find(private,P.Name)) and not find(party,P.Name) then
    action(j.id..":join",5,function() invoke("joinDungeon",owner.name) end)
   end
  end
  if P.UserId~=j.owner or not party then return end
  for _,m in ipairs(j.members) do if not find(party,m.name) then
   G.windows[j.id]=nil status("Waiting for all automated clients to join") return
  end end
  for _,v in ipairs(party:GetChildren()) do if v.Name~="mapName" and not G.allowed(v.Name,j.members) then
   G.windows[j.id]=nil status("Guest not allowed: "..v.Name.." — add their username or choose Anyone") return
  end end
  -- A bounded window, never a wait for a guest's telemetry or inventory.
  local signature=G.config.mode.."|"..G.config.names.."|"..G.config.waitSeconds
  local window=G.windows[j.id]
  if not window or window.party~=party or window.signature~=signature then
   window={party=party,signature=signature,started=now()} G.windows={[j.id]=window}
  end
  local remaining=G.config.waitSeconds-(now()-window.started)
  if remaining>0 then status("Guest join window: "..remaining.."s · "..G.config.mode) return end
  j.stage="departing" j.updated=now() j.startRequestedAt=now() j.startAttempts=(j.startAttempts or 0)+1 write(jobPath,j)
  fire("startDungeon") status("Starting dungeon with allowed guests")
 end
 F.workRequeue=G.workRequeue
 function G.mount()
  if C.NoUI or not B.tab or G.uiTab==B.tab then return end
